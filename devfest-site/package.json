{
  "name": "devfest-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prerender": "ng build",
    "serve:ssr": "node dist/devfest-site/server/server.mjs"
  },
  "prettier": {
